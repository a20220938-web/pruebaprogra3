@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using CineFlow.Web.Data

<HeadContent>
    <link href="/css/cineflow-front.css" rel="stylesheet" />
</HeadContent>

<style>
    /* Ocultar textos cuando el sidebar está colapsado */
    #sidebarToggle:checked ~ aside .sidebar-text {
        opacity: 0;
        visibility: hidden;
        width: 0;
        overflow: hidden;
    }
    aside .sidebar-text {
        transition: all 0.3s ease;
        opacity: 1;
        visibility: visible;
        width: auto;
    }
</style>

<div class="min-h-screen bg-background text-foreground font-sans antialiased">
    <div class="flex h-screen overflow-hidden">
        <input type="checkbox" id="sidebarToggle" class="peer hidden" />
        <!-- Sidebar -->
        <aside class="peer-checked:w-20 w-64 bg-card flex flex-col transition-all duration-300 relative z-20 shadow-none border-0">
            <!-- Botón colapsar -->
            <label for="sidebarToggle" class="absolute -right-3 top-8 bg-primary text-white rounded-full p-1 cursor-pointer shadow-md hover:bg-primary/90 transition-colors z-50">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 peer-checked:rotate-180 transition-transform"><polyline points="15 18 9 12 15 6"/></svg>
            </label>

            <div class="p-6 border-b border-border/50 flex items-center justify-center">
                <h1 class="text-2xl font-bold flex items-center gap-2" style="color: #c8402b;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"/></svg>
                    <span class="sidebar-text whitespace-nowrap">CineFlow Admin</span>
                </h1>
            </div>
            <nav class="flex-1 p-4 space-y-2 overflow-y-auto overflow-x-hidden">
                <a href="/admin/inventario" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md hover:bg-muted text-foreground transition-colors" title="Inventario">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0 text-primary"><path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/></svg>
                    <span class="sidebar-text whitespace-nowrap">Inventario</span>
                </a>
                <a href="/admin/ventas" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md hover:bg-muted text-foreground transition-colors" title="Ventas">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0 text-primary"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    <span class="sidebar-text whitespace-nowrap">Ventas</span>
                </a>
                <a href="/admin/confiteria" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md hover:bg-muted text-foreground transition-colors" title="Confitería">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0 text-primary"><path d="M2 14h20"/><path d="M4 14v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/><path d="M12 14v6"/><path d="M8 14v6"/><path d="M16 14v6"/><path d="M12 2a2 2 0 0 0-2 2v2H8a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v2h20v-2a2 2 0 0 0-2-2h-2V8a2 2 0 0 0-2-2h-2V4a2 2 0 0 0-2-2h-2Z"/></svg>
                    <span class="sidebar-text whitespace-nowrap">Confitería</span>
                </a>
                <a href="/admin/peliculas" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md hover:bg-muted text-foreground transition-colors" title="Películas">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0 text-primary"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M17 3v18"/><path d="M3 7h4"/><path d="M3 12h4"/><path d="M3 17h4"/><path d="M17 7h4"/><path d="M17 12h4"/><path d="M17 17h4"/></svg>
                    <span class="sidebar-text whitespace-nowrap">Películas</span>
                </a>
                <a href="/admin/cuentas" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md hover:bg-muted text-foreground transition-colors" title="Cuentas">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0 text-primary"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    <span class="sidebar-text whitespace-nowrap">Cuentas</span>
                </a>
            </nav>
            <div class="p-4 border-t border-border/50">
                <a href="/admin/logout" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md hover:bg-destructive hover:text-destructive-foreground text-muted-foreground transition-colors" title="Cerrar Sesión">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0 text-destructive"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                    <span class="sidebar-text whitespace-nowrap">Cerrar Sesión</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto bg-background p-8 relative z-10">
            @Body
        </main>
    </div>
</div>

@code {
    private void Logout()
    {
        MockDataStore.CurrentUser = null;
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
