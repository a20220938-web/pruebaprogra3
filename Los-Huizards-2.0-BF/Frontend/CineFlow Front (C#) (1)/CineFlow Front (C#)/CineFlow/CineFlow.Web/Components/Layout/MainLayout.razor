@inherits LayoutComponentBase
@using System.Security.Claims
@inject CineFlow.Web.Servicios.User.UserState UserState
@inject AuthenticationStateProvider AuthStateProvider

<div class="d-flex flex-column min-vh-100 bg-body-tertiary text-body">
    <NavMenu />
    <GlobalTimer />

    <main class="flex-grow-1">
        <div class="container py-4">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="alert alert-danger">
                        <h4>Error de Aplicación</h4>
                        <p>@ex.Message</p>
                        <pre>@ex.StackTrace</pre>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>

    <footer class="bg-body-tertiary text-body text-center py-3 mt-auto">
        <p class="mb-0">&copy; 2026 CineFlow - Los Huizards</p>
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (UserState.IsLoggedIn) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        if (principal.Identity?.IsAuthenticated != true) return;

        if (!int.TryParse(principal.FindFirst("userId")?.Value, out var userId)) return;

        UserState.Login(
            userId,
            principal.FindFirst(ClaimTypes.Name)?.Value  ?? "",
            principal.FindFirst("apellidos")?.Value       ?? "",
            principal.FindFirst(ClaimTypes.Email)?.Value  ?? ""
        );
    }
}
