@page "/Auth/Login"
@page "/login"
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Iniciar Sesión - CineFlow</PageTitle>

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="text-center mb-4">
                <i class="bi bi-film text-danger display-1"></i>
                <h1 class="text-body mt-3 fw-bold">CineFlow</h1>
            </div>

            <div class="card bg-body-tertiary text-body shadow-lg border-secondary border-opacity-50 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h3 class="card-title text-center mb-4 fw-bold">Iniciar Sesión</h3>

                    @if (hayError)
                    {
                        <div class="alert alert-danger py-2">Correo o contraseña incorrectos.</div>
                    }

                    <form method="post" action="/account/login">
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label text-body fw-semibold small">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-envelope"></i></span>
                                <input type="email" name="email" class="form-control bg-body text-body border-secondary" placeholder="nombre@ejemplo.com" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-body fw-semibold small">Contraseña</label>
                            <div class="input-group mt-1">
                                <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-lock"></i></span>
                                <input type="password" name="password" class="form-control bg-body text-body border-secondary" placeholder="••••••••" required />
                            </div>
                            <div class="text-end mt-2">
                                <a href="/forgot-password" class="text-danger small text-decoration-none fw-semibold">¿Olvidaste tu contraseña?</a>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 fw-bold rounded-pill py-2 mt-2 shadow">
                            Ingresar
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-danger fw-bold small mb-0">¿No tienes cuenta? <a href="/Auth/Register" class="text-danger fw-bold text-decoration-underline">Regístrate aquí</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorParam { get; set; }

    private bool hayError => !string.IsNullOrEmpty(ErrorParam);
}
