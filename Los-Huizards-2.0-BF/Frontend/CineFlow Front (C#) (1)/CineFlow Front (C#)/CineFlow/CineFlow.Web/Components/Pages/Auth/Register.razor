@page "/Auth/Register"
@page "/register"
@inject IAuthServiceClient AuthService
@inject NavigationManager Navigation

<PageTitle>Registrarse - CineFlow</PageTitle>

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus text-danger display-1"></i>
                <h1 class="text-body mt-3 fw-bold">Únete a CineFlow</h1>
            </div>
            
            <div class="card bg-body-tertiary text-body shadow-lg border-secondary border-opacity-50 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h3 class="card-title text-center mb-4 fw-bold">Crear Cuenta</h3>
                    
                    <EditForm Model="@registerModel" OnValidSubmit="HandleRegister" FormName="registerForm">
                        <DataAnnotationsValidator />
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-body fw-semibold small">Nombre</label>
                                <InputText @bind-Value="registerModel.Nombre" class="form-control bg-body text-body border-secondary" placeholder="Ej. Juan" />
                                <ValidationMessage For="@(() => registerModel.Nombre)" class="text-danger small mt-1" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-body fw-semibold small">Apellido</label>
                                <InputText @bind-Value="registerModel.Apellido" class="form-control bg-body text-body border-secondary" placeholder="Ej. Pérez" />
                                <ValidationMessage For="@(() => registerModel.Apellido)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-body fw-semibold small">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-envelope"></i></span>
                                <InputText @bind-Value="registerModel.Email" class="form-control bg-body text-body border-secondary" placeholder="nombre@ejemplo.com" />
                            </div>
                            <ValidationMessage For="@(() => registerModel.Email)" class="text-danger small mt-1" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-body fw-semibold small">Teléfono</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-phone"></i></span>
                                    <input type="tel" @bind="registerModel.Telefono" class="form-control bg-body text-body border-secondary" placeholder="9XXXXXXXX" maxlength="9" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                </div>
                                <ValidationMessage For="@(() => registerModel.Telefono)" class="text-danger small mt-1" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-body fw-semibold small">Fecha de Nacimiento</label>
                                <InputDate max="@DateTime.Now.ToString("yyyy-MM-dd")" @bind-Value="registerModel.FechaNacimiento" class="form-control bg-body text-body border-secondary" />
                                <ValidationMessage For="@(() => registerModel.FechaNacimiento)" class="text-danger small mt-1" />
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-body fw-semibold small">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-lock"></i></span>
                                <InputText type="password" @bind-Value="registerModel.Password" class="form-control bg-body text-body border-secondary" placeholder="••••••••" />
                            </div>
                            <div class="form-text text-body-secondary small mt-1">
                                <i class="bi bi-info-circle me-1"></i>Mínimo 6 caracteres y al menos 1 carácter especial (ej: <code>!@@#$%</code>)
                            </div>
                            <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-body fw-semibold small">Confirmar Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-lock-fill"></i></span>
                                <InputText type="password" @bind-Value="registerModel.ConfirmPassword" class="form-control bg-body text-body border-secondary" placeholder="••••••••" />
                            </div>
                            <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="text-danger small mt-1" />
                        </div>
                        
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2">@errorMessage</div>
                        }

                        <button type="submit" class="btn btn-danger w-100 fw-bold rounded-pill py-2 mt-2 shadow" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <span>Registrarse</span>
                            }
                        </button>
                    </EditForm>
                    
                    <div class="text-center mt-4">
                        <p class="text-danger fw-bold small mb-0">¿Ya tienes cuenta? <a href="/Auth/Login" class="text-danger fw-bold text-decoration-underline">Inicia sesión</a></p>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

@code {
    private RegisterViewModel registerModel { get; set; } = new();

    private bool isLoading;
    private string? errorMessage;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var success = await AuthService.RegisterAsync(registerModel);
            if (success)
            {
                Navigation.NavigateTo("/Auth/Login");
            }
            else
            {
                errorMessage = "No se pudo registrar la cuenta. Intente nuevamente.";
            }
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
