@page "/theaters"
@using CineFlow.Web.Data

<PageTitle>Cines - CineFlow</PageTitle>

<div class="container py-5 text-body">
    <h2 class="mb-4 fw-bold">Nuestros Cines</h2>

    <div class="list-group">
        @foreach (var cine in Cines)
        {
            <div class="list-group-item list-group-item-action bg-body-tertiary text-body p-4 shadow-sm mb-3 border-secondary rounded">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1 fw-bold text-danger">@cine.Nombre</h5>
                    <span class="badge bg-success align-self-start">Abierto ahora</span>
                </div>
                <p class="mb-1">@cine.Ubicacion</p>
                <small class="text-muted">Salas 2D, 3D.</small>
                <div class="mt-3">
                    <button class="btn btn-sm btn-outline-danger" disabled>Ver en Mapa (Próximamente)</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<MockCine> Cines;

    protected override void OnInitialized()
    {
        Cines = MockDataStore.Cines;
    }
}
