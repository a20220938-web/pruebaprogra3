@page "/restablecer-contrasenia"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Restablecer Contraseña - CineFlow</PageTitle>

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock text-danger display-1"></i>
                <h1 class="text-body mt-3 fw-bold">CineFlow</h1>
            </div>

            <div class="card bg-body-tertiary text-body shadow-lg border-secondary border-opacity-50 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h3 class="card-title text-center mb-4 fw-bold">Nueva Contraseña</h3>

                    @if (tokenInvalido)
                    {
                        <div class="alert alert-danger text-center py-3">
                            <i class="bi bi-x-circle-fill fs-4 d-block mb-2"></i>
                            <p class="mb-1 fw-semibold">Enlace inválido o expirado</p>
                            <p class="mb-0 small">El enlace de recuperación no es válido o ya expiró. Solicita uno nuevo.</p>
                        </div>
                        <a href="/forgot-password" class="btn btn-outline-danger w-100 fw-bold rounded-pill py-2 mt-3">
                            Solicitar nuevo enlace
                        </a>
                    }
                    else if (exito)
                    {
                        <div class="alert alert-success text-center py-3">
                            <i class="bi bi-check-circle-fill fs-4 d-block mb-2"></i>
                            <p class="mb-1 fw-semibold">¡Contraseña actualizada!</p>
                            <p class="mb-0 small">Tu contraseña ha sido restablecida correctamente.</p>
                        </div>
                        <a href="/login" class="btn btn-danger w-100 fw-bold rounded-pill py-2 mt-3">
                            Iniciar Sesión
                        </a>
                    }
                    else
                    {
                        <p class="text-body-secondary text-center small mb-4">
                            Ingresa tu nueva contraseña para restablecer el acceso a tu cuenta.
                        </p>

                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger py-2">@errorMsg</div>
                        }

                        <form @onsubmit="CambiarContrasenia" @onsubmit:preventDefault="true">
                            <div class="mb-3">
                                <label class="form-label text-body fw-semibold small">Nueva Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-lock"></i></span>
                                    <input type="password" @bind="nuevaContrasenia"
                                           class="form-control bg-body text-body border-secondary"
                                           placeholder="Mínimo 6 caracteres" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label text-body fw-semibold small">Confirmar Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-lock-fill"></i></span>
                                    <input type="password" @bind="confirmarContrasenia"
                                           class="form-control bg-body text-body border-secondary"
                                           placeholder="Repite la contraseña" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-danger w-100 fw-bold rounded-pill py-2 mt-2 shadow" disabled="@cargando">
                                @if (cargando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                Restablecer Contraseña
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenQuery { get; set; }

    private string token = string.Empty;
    private string nuevaContrasenia = string.Empty;
    private string confirmarContrasenia = string.Empty;
    private bool cargando;
    private bool exito;
    private bool tokenInvalido;
    private string? errorMsg;

    protected override void OnInitialized()
    {
        token = TokenQuery ?? string.Empty;
        if (string.IsNullOrWhiteSpace(token))
            tokenInvalido = true;
    }

    private async Task CambiarContrasenia()
    {
        errorMsg = null;

        if (string.IsNullOrWhiteSpace(nuevaContrasenia) || nuevaContrasenia.Length < 6)
        {
            errorMsg = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        if (nuevaContrasenia != confirmarContrasenia)
        {
            errorMsg = "Las contraseñas no coinciden.";
            return;
        }

        cargando = true;

        try
        {
            var apiUrl = Configuration.GetValue<string>("ApiUrl") ?? "http://localhost:8080/CineFlowRS-1.0-SNAPSHOT/api/";
            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(apiUrl);
            client.Timeout = TimeSpan.FromSeconds(10);

            using var response = await client.PostAsJsonAsync("v1/auth/restablecer-contrasenia",
                new { token, nuevaContrasenia });

            if (response.IsSuccessStatusCode)
                exito = true;
            else
            {
                try
                {
                    var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    errorMsg = body.TryGetProperty("error", out var err) ? err.GetString() : "Ocurrió un error al restablecer la contraseña.";
                    if (errorMsg != null && errorMsg.Contains("inválido o ha expirado"))
                        tokenInvalido = true;
                }
                catch
                {
                    errorMsg = "Ocurrió un error al restablecer la contraseña. Intenta nuevamente.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMsg = "Error: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
