@page "/movies/{MovieId}/seats/{FuncionId}/payment"
@using System.Threading.Tasks
@using CineFlow.Web.Servicios.Reserva
@using CineFlow.Web.ViewModels.Catalogo
@using CineFlow.Web.ViewModels.Reserva
@inject NavigationManager NavigationManager
@inject BookingState BookingState
@inject IReservasServiceClient ReservasService
@inject IConfiteriaServiceClient ConfiteriaService
@inject CineFlow.Web.Servicios.User.UserState UserState

<PageTitle>Pago - CineFlow</PageTitle>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-danger">Finaliza tu Compra</h2>
        <CancelReservation MovieId="@MovieId" />
    </div>
    
    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm border-secondary mb-4 bg-body">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-4 text-body"><i class="bi bi-wallet2 me-2 text-danger"></i>Método de Pago</h5>
                    
                    <div class="btn-group w-100 mb-4" role="group">
                        <input type="radio" class="btn-check" name="paymentMethod" id="btnCreditCard" autocomplete="off" checked="@(paymentMethod == "Card")" @onchange="@(() => paymentMethod = "Card")">
                        <label class="btn btn-outline-danger fw-bold" for="btnCreditCard"><i class="bi bi-credit-card me-2"></i>Tarjeta</label>

                        <input type="radio" class="btn-check" name="paymentMethod" id="btnYape" autocomplete="off" checked="@(paymentMethod == "Yape")" @onchange="@(() => paymentMethod = "Yape")">
                        <label class="btn fw-bold" for="btnYape" style="border: 2px solid #702b89; color: #702b89;"><i class="bi bi-qr-code-scan me-2"></i>Yape</label>

                        <input type="radio" class="btn-check" name="paymentMethod" id="btnPlin" autocomplete="off" checked="@(paymentMethod == "Plin")" @onchange="@(() => paymentMethod = "Plin")">
                        <label class="btn fw-bold" for="btnPlin" style="border: 2px solid #00b2e3; color: #00b2e3;"><i class="bi bi-qr-code-scan me-2"></i>Plin</label>
                    </div>
                    
                    <form @onsubmit="ProcessPayment" @onsubmit.preventDefault="true">
                        @if (paymentMethod == "Card")
                        {
                            <div class="mb-3">
                                <label class="form-label text-secondary fw-semibold">Número de Tarjeta</label>
                                <input type="text"
                                       class="@CardFieldClass("cardNumber")"
                                       placeholder="0000 0000 0000 0000"
                                       maxlength="19"
                                       inputmode="numeric"
                                       onkeydown="if(!/[0-9]/.test(event.key)&&!['Backspace','Delete','Tab','ArrowLeft','ArrowRight','Home','End'].includes(event.key)&&!event.ctrlKey&&!event.metaKey)event.preventDefault();"
                                       value="@cardNumber"
                                       @oninput="OnCardNumberInput" />
                                @if (fieldErrors.ContainsKey("cardNumber"))
                                {
                                    <div class="invalid-feedback">@fieldErrors["cardNumber"]</div>
                                }
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-secondary fw-semibold">Fecha de Expiración</label>
                                    <input type="text"
                                           class="@CardFieldClass("expiry")"
                                           placeholder="MM/YY"
                                           maxlength="5"
                                           inputmode="numeric"
                                           onkeydown="if(!/[0-9]/.test(event.key)&&!['Backspace','Delete','Tab','ArrowLeft','ArrowRight','Home','End'].includes(event.key)&&!event.ctrlKey&&!event.metaKey)event.preventDefault();"
                                           value="@cardExpiry"
                                           @oninput="OnExpiryInput" />
                                    @if (fieldErrors.ContainsKey("expiry"))
                                    {
                                        <div class="invalid-feedback">@fieldErrors["expiry"]</div>
                                    }
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-secondary fw-semibold">CVV</label>
                                    <input type="password"
                                           class="@CardFieldClass("cvv")"
                                           placeholder="123"
                                           maxlength="4"
                                           inputmode="numeric"
                                           onkeydown="if(!/[0-9]/.test(event.key)&&!['Backspace','Delete','Tab','ArrowLeft','ArrowRight','Home','End'].includes(event.key)&&!event.ctrlKey&&!event.metaKey)event.preventDefault();"
                                           value="@cardCvv"
                                           @oninput="OnCvvInput" />
                                    @if (fieldErrors.ContainsKey("cvv"))
                                    {
                                        <div class="invalid-feedback">@fieldErrors["cvv"]</div>
                                    }
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label text-secondary fw-semibold">Nombre en la Tarjeta</label>
                                <input type="text"
                                       class="@CardFieldClass("cardName")"
                                       placeholder="Juan Pérez"
                                       value="@cardName"
                                       @oninput="OnCardNameInput" />
                                @if (fieldErrors.ContainsKey("cardName"))
                                {
                                    <div class="invalid-feedback">@fieldErrors["cardName"]</div>
                                }
                            </div>
                        }
                        else if (paymentMethod == "Yape")
                        {
                            <div class="text-center mb-4">
                                <h6 class="fw-bold text-body mb-3">Escanea el QR para pagar con Yape</h6>
                                <div class="p-3 bg-white rounded shadow-sm d-inline-block border mb-3" style="border-color: #702b89 !important; border-width: 2px !important;">
                                    <img src="/images/yape-qr.jpg" alt="QR Yape" style="width: 150px; height: 150px;">
                                </div>
                                <p class="mb-1 text-secondary">A nombre de: <strong>Nano Banana</strong></p>
                                <p class="mb-4 fs-5 fw-bold" style="color: #702b89;">999 888 777</p>

                                <div class="text-start">
                                    <label class="form-label text-secondary fw-semibold">Tu Número de Celular (Yape)</label>
                                    <input type="text"
                                           class="@CardFieldClass("phone")"
                                           placeholder="9XX XXX XXX"
                                           maxlength="9"
                                           value="@phoneNumber"
                                           @oninput="OnPhoneInput" />
                                    @if (fieldErrors.ContainsKey("phone"))
                                    {
                                        <div class="invalid-feedback">@fieldErrors["phone"]</div>
                                    }
                                </div>
                            </div>
                        }
                        else if (paymentMethod == "Plin")
                        {
                            <div class="text-center mb-4">
                                <h6 class="fw-bold text-body mb-3">Escanea el QR para pagar con Plin</h6>
                                <div class="p-3 bg-white rounded shadow-sm d-inline-block border mb-3" style="border-color: #00b2e3 !important; border-width: 2px !important;">
                                    <img src="/images/plin-qr.jpg" alt="QR Plin" style="width: 150px; height: 150px;">
                                </div>
                                <p class="mb-1 text-secondary">A nombre de: <strong>Nano Banana</strong></p>
                                <p class="mb-4 fs-5 fw-bold" style="color: #00b2e3;">999 888 777</p>

                                <div class="text-start">
                                    <label class="form-label text-secondary fw-semibold">Tu Número de Celular (Plin)</label>
                                    <input type="text"
                                           class="@CardFieldClass("phone")"
                                           placeholder="9XX XXX XXX"
                                           maxlength="9"
                                           value="@phoneNumber"
                                           @oninput="OnPhoneInput" />
                                    @if (fieldErrors.ContainsKey("phone"))
                                    {
                                        <div class="invalid-feedback">@fieldErrors["phone"]</div>
                                    }
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger mt-3">@errorMsg</div>
                        }

                        <button type="submit" class="btn btn-danger w-100 fw-bold py-3 fs-5 shadow mt-3" disabled="@(isProcessing || !reservaCreada)">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Procesando pago...</span>
                            }
                            else
                            {
                                <span>@(paymentMethod == "Card" ? "Pagar con Tarjeta" : paymentMethod == "Yape" ? "Confirmar Yapeo" : "Confirmar Plin")</span>
                            }
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100 fw-bold py-2 mt-2" disabled="@isProcessing" @onclick="GoBack">
                            <i class="bi bi-arrow-left me-2"></i>Regresar a Confitería
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-5">
            <div class="card border-danger shadow-lg bg-body">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title fw-bold m-0"><i class="bi bi-receipt me-2"></i>Resumen del Pedido</h5>
                </div>
                <div class="card-body p-4">
                    @if (Funcion != null)
                    {
                        <p class="mb-1 text-body"><strong>Película:</strong> @Funcion.Pelicula?.Titulo</p>
                        <p class="mb-1 text-body"><strong>Sala:</strong> @Funcion.Sala?.Numero</p>
                        <p class="mb-1 text-body"><strong>Sede:</strong> @Funcion.Sala?.Cine?.Nombre</p>
                        <p class="mb-3 text-body"><strong>Fecha:</strong> @Funcion.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>

                        <hr class="border-secondary opacity-50" />

                        <h6 class="fw-bold text-danger">Entradas (@BookingState.SelectedSeats.Count asientos)</h6>
                        @foreach (var seatId in BookingState.SelectedSeats)
                        {
                            var type = BookingState.TicketTypes.ContainsKey(seatId) ? BookingState.TicketTypes[seatId] : "REGULAR";
                            double price = type switch {
                                "NIÑO" => Funcion.PrecioBase * 0.7,
                                "CONADIS" => Funcion.PrecioBase * 0.5,
                                _ => Funcion.PrecioBase
                            };
                            var asientoLabel = Funcion.MapaAsientos?.FirstOrDefault(a => a.IdAsiento == seatId)?.Label ?? seatId.ToString();
                            <p class="d-flex justify-content-between text-body-secondary mb-1">
                                <span>1 x @type (Asiento @asientoLabel)</span>
                                <span class="text-body fw-semibold">S/ @price.ToString("0.00")</span>
                            </p>
                        }

                        @if (BookingState.SelectedSnacks.Any())
                        {
                            <h6 class="mt-4 fw-bold text-danger">Snacks</h6>
                            @foreach (var snack in BookingState.SelectedSnacks)
                            {
                                var snackDetails = BookingState.AvailableSnacks.FirstOrDefault(s => s.IdItem == snack.Key);
                                if (snackDetails != null)
                                {
                                    <p class="d-flex justify-content-between text-body-secondary mb-1">
                                        <span>@snack.Value x @snackDetails.Nombre</span>
                                        <span class="text-body fw-semibold">S/ @((snackDetails.PrecioUnitario * snack.Value).ToString("0.00"))</span>
                                    </p>
                                }
                            }
                        }

                        <hr class="border-danger opacity-75 mt-4" />

                        <div class="bg-body-secondary p-3 rounded d-flex justify-content-between align-items-center border border-danger border-opacity-25 mt-3">
                            <span class="fs-5 fw-bold text-body">Total a Pagar:</span>
                            <span class="fs-4 fw-bold text-danger">S/ @GetGranTotal().ToString("0.00")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string MovieId { get; set; }

    [Parameter]
    public string FuncionId { get; set; }

    private FuncionViewModel Funcion;
    private string paymentMethod = "Card";

    // IDs obtenidos al crear la reserva en carga de página
    private int idReserva = 0;
    private int idPago = 0;
    private bool reservaCreada = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsLoggedIn)
        {
            NavigationManager.NavigateTo($"/login?returnUrl=/movies/{MovieId}/seats/{FuncionId}/payment", forceLoad: false);
            return;
        }
        Funcion = BookingState.CurrentFuncion;
        if (Funcion == null) return;

        // Crear la reserva (y el pago PENDIENTE) en cuanto carga la página
        // → asientos pasan a estado RESERVADO (3) inmediatamente
        try
        {
            var total = GetGranTotal();
            var payload = BuildReservaPayload("TARJETA", total);
            var nueva = await ReservasService.CrearAsync(payload);

            if (nueva != null && nueva.IdReserva > 0 && nueva.Pago?.IdPago > 0)
            {
                idReserva = nueva.IdReserva;
                idPago    = nueva.Pago!.IdPago;
                reservaCreada = true;
                BookingState.IdReserva = nueva.IdReserva;
            }
            else
            {
                errorMsg = "No se pudo reservar los asientos. Intenta de nuevo.";
            }
        }
        catch (Exception ex)
        {
            errorMsg = $"Error al reservar asientos: {ex.Message}";
        }
    }

    private double GetGranTotal()
    {
        if (Funcion == null) return 0;
        
        double total = 0;
        
        // Sumar asientos
        foreach (var seatId in BookingState.SelectedSeats)
        {
            var type = BookingState.TicketTypes.ContainsKey(seatId) ? BookingState.TicketTypes[seatId] : "REGULAR";
            total += type switch {
                "NIÑO" => Funcion.PrecioBase * 0.7,
                "CONADIS" => Funcion.PrecioBase * 0.5,
                _ => Funcion.PrecioBase
            };
        }
        
        // Sumar snacks
        foreach (var snack in BookingState.SelectedSnacks)
        {
            var snackDetails = BookingState.AvailableSnacks.FirstOrDefault(s => s.IdItem == snack.Key);
            if (snackDetails != null)
            {
                total += snackDetails.PrecioUnitario * snack.Value;
            }
        }
        
        return total;
    }

    private bool isProcessing = false;
    private string errorMsg = string.Empty;

    // Campos del formulario
    private string cardNumber = string.Empty;
    private string cardExpiry = string.Empty;
    private string cardCvv = string.Empty;
    private string cardName = string.Empty;
    private string phoneNumber = string.Empty;
    private Dictionary<string, string> fieldErrors = new Dictionary<string, string>();

    private string CardFieldClass(string key)
    {
        var invalid = fieldErrors.ContainsKey(key) ? " is-invalid" : string.Empty;
        return "form-control border-secondary bg-body-tertiary text-body shadow-sm" + invalid;
    }

    private void OnCardNumberInput(ChangeEventArgs e)
    {
        var raw = e.Value != null ? e.Value.ToString() : string.Empty;
        var digits = new string(System.Linq.Enumerable.Where(raw, char.IsDigit).ToArray());
        if (digits.Length > 16) digits = digits.Substring(0, 16);
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < digits.Length; i++)
        {
            if (i > 0 && i % 4 == 0) sb.Append(' ');
            sb.Append(digits[i]);
        }
        cardNumber = sb.ToString();
    }

    private void OnExpiryInput(ChangeEventArgs e)
    {
        var raw = e.Value != null ? e.Value.ToString() : string.Empty;
        var digits = new string(System.Linq.Enumerable.Where(raw, char.IsDigit).ToArray());
        if (digits.Length > 4) digits = digits.Substring(0, 4);
        cardExpiry = digits.Length >= 2 ? digits.Substring(0, 2) + "/" + digits.Substring(2) : digits;
    }

    private void OnCvvInput(ChangeEventArgs e)
    {
        var raw = e.Value != null ? e.Value.ToString() : string.Empty;
        var digits = new string(System.Linq.Enumerable.Where(raw, char.IsDigit).ToArray());
        cardCvv = digits.Length > 4 ? digits.Substring(0, 4) : digits;
    }

    private void OnCardNameInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        cardName = new string(raw.Where(c => char.IsLetter(c) || c == ' ' || c == '\'' || c == '-').ToArray());
    }

    private void OnPhoneInput(ChangeEventArgs e)
    {
        var raw = e.Value != null ? e.Value.ToString() : string.Empty;
        var digits = new string(System.Linq.Enumerable.Where(raw, char.IsDigit).ToArray());
        phoneNumber = digits.Length > 9 ? digits.Substring(0, 9) : digits;
    }

    private bool ValidateForm()
    {
        fieldErrors.Clear();

        if (paymentMethod == "Card")
        {
            var digits = new string(System.Linq.Enumerable.Where(cardNumber, char.IsDigit).ToArray());
            if (digits.Length != 16)
                fieldErrors["cardNumber"] = "El número de tarjeta debe tener 16 dígitos.";

            if (!System.Text.RegularExpressions.Regex.IsMatch(cardExpiry, @"^(0[1-9]|1[0-2])\/\d{2}$"))
            {
                fieldErrors["expiry"] = "Formato inválido. Usa MM/YY.";
            }
            else
            {
                var parts = cardExpiry.Split('/');
                int month = int.Parse(parts[0]);
                int year = 2000 + int.Parse(parts[1]);
                var expDate = new DateTime(year, month, 1).AddMonths(1);
                if (expDate <= DateTime.Now)
                    fieldErrors["expiry"] = "La tarjeta está vencida.";
            }

            var cvvDigits = new string(System.Linq.Enumerable.Where(cardCvv, char.IsDigit).ToArray());
            if (cvvDigits.Length < 3 || cvvDigits.Length > 4)
                fieldErrors["cvv"] = "El CVV debe tener 3 o 4 dígitos.";

            if (string.IsNullOrWhiteSpace(cardName) || cardName.Trim().Length < 3)
                fieldErrors["cardName"] = "Ingresa el nombre tal como aparece en la tarjeta.";
        }
        else
        {
            var phoneDigits = new string(System.Linq.Enumerable.Where(phoneNumber, char.IsDigit).ToArray());
            if (phoneDigits.Length != 9 || phoneDigits[0] != '9')
                fieldErrors["phone"] = "Ingresa un número celular peruano válido (9 dígitos, empieza con 9).";
        }

        return fieldErrors.Count == 0;
    }

    private ReservaViewModel BuildReservaPayload(string metodoPago, double total) =>
        new ReservaViewModel
        {
            Usuario = new UsuarioReservaViewModel { IdUsuario = UserState.UserId!.Value },
            Funcion = new FuncionReservaViewModel
            {
                Id       = Funcion!.Id,
                FechaHora = Funcion.FechaHora,
                Pelicula = Funcion.Pelicula,
                Sala     = Funcion.Sala
            },
            Pago = new PagoReservaViewModel { Monto = total, Metodo = metodoPago },
            Asientos = BookingState.SelectedSeats.Select(s =>
            {
                var a = Funcion?.MapaAsientos?.FirstOrDefault(x => x.IdAsiento == s);
                return new AsientoReservaViewModel
                {
                    IdAsiento = s,
                    Fila      = a?.Fila.ToString() ?? "",
                    Numero    = a?.Numero ?? 0
                };
            }).ToList(),
            Entradas = BookingState.SelectedSeats.Select(s =>
            {
                var type     = BookingState.TicketTypes.GetValueOrDefault(s, "REGULAR");
                var javaType = type == "NIÑO" ? "NINO" : type;
                return new EntradaViewModel { PrecioBase = Funcion!.PrecioBase, Tipo = javaType };
            }).ToList(),

            Confiterias = BookingState.SelectedSnacks
                .Where(kv => kv.Value > 0)
                .Select(kv =>
                {
                    var d = BookingState.AvailableSnacks.FirstOrDefault(s => s.IdItem == kv.Key);
                    return new ConfiteriaReservaViewModel
                    {
                        IdItem = kv.Key,
                        Nombre = d?.Nombre ?? string.Empty,
                        Cantidad = kv.Value,
                        PrecioUnitario = d?.PrecioUnitario ?? 0,
                        Categoria = d?.Categoria ?? string.Empty,
                        IdInventario = d?.IdInventario ?? 0
                    };
                }).ToList()
        };

    private async Task GoBack()
    {
        if (idReserva > 0)
        {
            try { await ReservasService.CancelarReservaAsync(idReserva); } catch { }
            BookingState.IdReserva = 0;
            idReserva = 0;
            idPago = 0;
            reservaCreada = false;
        }
        NavigationManager.NavigateTo($"/movies/{MovieId}/seats/{FuncionId}/snacks");
    }

    private async Task ProcessPayment()
    {
        if (!ValidateForm()) return;

        if (!reservaCreada || idPago <= 0)
        {
            errorMsg = "Los asientos aún no están reservados. Recarga la página e intenta de nuevo.";
            return;
        }

        isProcessing = true;
        errorMsg = string.Empty;
        try
        {
            // Simular fallo para número de prueba en Yape/Plin
        if (paymentMethod != "Card" && phoneNumber == "987654321")
        {
            errorMsg = "El pago fue rechazado. Verifica tu número de Yape/Plin e intenta de nuevo.";
            isProcessing = false;
            return;
        }

        // Paso 0: Registrar el método de pago elegido por el usuario
            // (Tarjeta -> TARJETA; Yape/Plin -> BILLETERA_DIGITAL)
            var metodoBackend = paymentMethod == "Card" ? "TARJETA" : "BILLETERA_DIGITAL";
            await ReservasService.ActualizarMetodoPagoAsync(idPago, metodoBackend, GetGranTotal());

            // Paso 1: Procesar el pago con Stripe (tarjeta) o simulado (Yape/Plin)
            var metodoBackendProcesar = paymentMethod == "Card" ? "TARJETA" : "BILLETERA_DIGITAL";
            var resultado = await ReservasService.ProcesarPagoAsync(
                idPago, metodoBackendProcesar,
                cardNumber, cardExpiry, cardCvv);
            if (resultado == null)
            {
                errorMsg = "Error al conectar con el procesador de pagos. Intenta de nuevo.";
                return;
            }

            if (!resultado.Aprobado)
            {
                errorMsg = "El pago fue rechazado. Los asientos se liberarán cuando venza el plazo de 5 minutos.";
                return;
            }

            // Paso 2: Confirmar (asientos RESERVADO → OCUPADO, reserva → CONFIRMADA)
            var confirmado = await ReservasService.ConfirmarPagoAsync(idPago);
            if (!confirmado)
            {
                errorMsg = "El pago fue aprobado pero hubo un error al confirmar. Contacta con soporte.";
                return;
            }

            // El stock de confitería ya se descuenta en el backend al confirmar el pago
            // (PagoBoImpl.confirmarTransaccion -> descontarStockConfiteriaPorReserva).
            // No se descuenta aquí para evitar el doble descuento.

            BookingState.Clear();
            NavigationManager.NavigateTo($"/ticket/{idReserva}");
        }
        catch (TaskCanceledException)
        {
            errorMsg = "El pago está tardando más de lo esperado. No se cerró la operación — verifica el estado en tu historial antes de reintentar.";
        }
        catch (HttpRequestException ex)
        {
            errorMsg = $"Error de conexión con el servidor de pagos: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMsg = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
