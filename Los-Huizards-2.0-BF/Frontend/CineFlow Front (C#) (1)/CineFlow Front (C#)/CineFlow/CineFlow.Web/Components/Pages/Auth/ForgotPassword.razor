@page "/Auth/ForgotPassword"
@page "/forgot-password"
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Recuperación de Contraseña - CineFlow</PageTitle>

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock text-danger display-1"></i>
                <h1 class="text-body mt-3 fw-bold">CineFlow</h1>
            </div>

            <div class="card bg-body-tertiary text-body shadow-lg border-secondary border-opacity-50 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h3 class="card-title text-center mb-4 fw-bold">Recuperación de Contraseña</h3>

                    @if (enviado)
                    {
                        <div class="alert alert-success text-center py-3">
                            <i class="bi bi-check-circle-fill fs-4 d-block mb-2"></i>
                            <p class="mb-1 fw-semibold">¡Enlace enviado!</p>
                            <p class="mb-0 small">El enlace de recuperación ha sido enviado correctamente al correo electrónico ingresado.</p>
                        </div>
                        <a href="/login" class="btn btn-outline-danger w-100 fw-bold rounded-pill py-2 mt-3">
                            Volver al inicio de sesión
                        </a>
                    }
                    else
                    {
                        <p class="text-body-secondary text-center small mb-4">
                            Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.
                        </p>

                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger py-2">@errorMsg</div>
                        }

                        <form @onsubmit="EnviarEnlace" @onsubmit:preventDefault="true">
                            <div class="mb-4">
                                <label class="form-label text-body fw-semibold small">Correo Electrónico</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary border-secondary text-body"><i class="bi bi-envelope"></i></span>
                                    <input type="email" @bind="email" class="form-control bg-body text-body border-secondary" placeholder="nombre@ejemplo.com" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-danger w-100 fw-bold rounded-pill py-2 mt-2 shadow" disabled="@cargando">
                                @if (cargando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                Enviar enlace de acceso
                            </button>
                        </form>

                        <div class="text-center mt-4">
                            <p class="text-body-secondary small mb-0">
                                <a href="/login" class="text-danger fw-bold text-decoration-none">
                                    <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                                </a>
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private bool cargando;
    private bool enviado;
    private string? errorMsg;

    private async Task EnviarEnlace()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMsg = "Ingresa un correo electrónico.";
            return;
        }

        cargando = true;
        errorMsg = null;

        try
        {
            var apiUrl = Configuration.GetValue<string>("ApiUrl") ?? "http://localhost:8080/CineFlowRS-1.0-SNAPSHOT/api/";
            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(apiUrl);
            client.Timeout = TimeSpan.FromSeconds(10);

            using var response = await client.PostAsJsonAsync("v1/auth/recuperar-contrasenia", new { email });

            if (response.IsSuccessStatusCode)
            {
                enviado = true;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMsg = "El correo ingresado no está registrado.";
            }
            else
            {
                try
                {
                    var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    errorMsg = body.TryGetProperty("error", out var err) ? err.GetString() : "Ocurrió un error al procesar la solicitud.";
                }
                catch
                {
                    errorMsg = "Ocurrió un error al procesar la solicitud. Intenta nuevamente.";
                }
            }
        }
        catch (HttpRequestException)
        {
            errorMsg = "No se pudo conectar con el servidor. Verifica tu conexión e intenta nuevamente.";
        }
        catch (TaskCanceledException)
        {
            errorMsg = "La solicitud tardó demasiado. Intenta nuevamente.";
        }
        catch (Exception)
        {
            errorMsg = "Ocurrió un error inesperado. Intenta nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }
}
