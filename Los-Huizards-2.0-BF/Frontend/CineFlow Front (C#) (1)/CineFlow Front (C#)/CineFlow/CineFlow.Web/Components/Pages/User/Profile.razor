@page "/User/Profile"
@page "/profile"
@inject IUserServiceClient UserService

<PageTitle>Mi Perfil - CineFlow</PageTitle>

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-body-tertiary text-body shadow-lg border-secondary border-opacity-50 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h3 class="card-title text-center mb-4 fw-bold">Mi Perfil</h3>

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-danger" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3 text-muted">Cargando perfil...</p>
                        </div>
                    }
                    else if (userProfile != null)
                    {
                        <div class="text-center mb-4">
                            <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">
                                @(string.IsNullOrEmpty(userProfile.Nombre) ? "" : userProfile.Nombre.Substring(0, 1))@(string.IsNullOrEmpty(userProfile.Apellido) ? "" : userProfile.Apellido.Substring(0, 1))
                            </div>
                            <h4 class="mt-3 fw-bold mb-1">@userProfile.Nombre @userProfile.Apellido</h4>
                            <span class="badge bg-danger rounded-pill">Miembro de CineFlow</span>
                        </div>

                        <ul class="list-group list-group-flush bg-transparent border-secondary border-opacity-50 rounded-3 mb-4">
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center py-3 border-secondary border-opacity-50">
                                <span class="text-muted small fw-semibold">Correo Electrónico</span>
                                <span class="fw-bold">@userProfile.Email</span>
                            </li>
                            <li class="list-group-item bg-transparent py-3 border-secondary border-opacity-50">
                                @if (!isEditing)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted small fw-semibold">Teléfono</span>
                                        <span class="fw-bold">@(string.IsNullOrEmpty(userProfile.Telefono) ? "No especificado" : userProfile.Telefono)</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small fw-semibold">Fecha de Nacimiento</span>
                                        <span class="fw-bold">@(userProfile.FechaNacimiento.HasValue ? userProfile.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "No especificada")</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-2">
                                        <label class="form-label text-muted small fw-semibold">Teléfono</label>
                                        <input type="text" class="form-control bg-body text-body" @bind="editTelefono" placeholder="Escribe tu número..." />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label text-muted small fw-semibold">Fecha de Nacimiento</label>
                                        <input type="date" class="form-control bg-body text-body" @bind="editFechaNacimiento" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label text-muted small fw-semibold">Nombre</label>
                                        <input type="text" class="form-control bg-body text-body" @bind="editNombre" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label text-muted small fw-semibold">Apellidos</label>
                                        <input type="text" class="form-control bg-body text-body" @bind="editApellido" />
                                    </div>
                                }
                            </li>
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center py-3 border-secondary border-opacity-50">
                                <span class="text-muted small fw-semibold">Miembro desde</span>
                                <span class="fw-bold">@userProfile.FechaRegistro.ToString("dd MMMM yyyy")</span>
                            </li>
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center py-3 border-secondary border-opacity-50">
                                <span class="text-muted small fw-semibold">ID de Usuario</span>
                                <span class="fw-bold">#@userProfile.Id</span>
                            </li>
                        </ul>

                        <div class="d-grid gap-2">
                            @if (!isEditing)
                            {
                                <button class="btn btn-danger fw-bold rounded-pill py-2" @onclick="() => EnableEdit()">Editar Perfil</button>
                                <a href="/User/Tickets" class="btn btn-outline-danger fw-bold rounded-pill py-2 mt-2">Ver Mis Entradas</a>
                            }
                            else
                            {
                                <button class="btn btn-success fw-bold rounded-pill py-2" @onclick="SaveProfile" disabled="@isSaving">
                                    @if(isSaving){ <span>Guardando...</span> } else { <span>Guardar Cambios</span> }
                                </button>
                                <button class="btn btn-outline-secondary fw-bold rounded-pill py-2 mt-2" @onclick="CancelEdit" disabled="@isSaving">Cancelar</button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserProfileViewModel userProfile;
    private bool isLoading = true;

    private bool isEditing = false;
    private bool isSaving = false;
    private string editTelefono = "";
    private string editNombre = "";
    private string editApellido = "";
    private DateTime? editFechaNacimiento;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        try
        {
            isLoading = true;
            userProfile = await UserService.GetProfileAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EnableEdit()
    {
        isEditing = true;
        editTelefono = userProfile.Telefono;
        editNombre = userProfile.Nombre;
        editApellido = userProfile.Apellido;
        editFechaNacimiento = userProfile.FechaNacimiento;
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private async Task SaveProfile()
    {
        isSaving = true;
        userProfile.Telefono = editTelefono;
        userProfile.Nombre = editNombre;
        userProfile.Apellido = editApellido;
        userProfile.FechaNacimiento = editFechaNacimiento;

        var success = await UserService.UpdateProfileAsync(userProfile);
        isSaving = false;
        if (success)
        {
            isEditing = false;
        }
        else
        {
            // Opcional: mostrar error
        }
    }
}
