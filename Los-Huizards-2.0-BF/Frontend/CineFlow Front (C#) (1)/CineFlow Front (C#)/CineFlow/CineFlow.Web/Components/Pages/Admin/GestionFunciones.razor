@page "/admin/funciones"
@using CineFlow.Web.Servicios.Catalogo
@using CineFlow.Web.ViewModels.Catalogo
@inject CineFlow.Web.Servicios.User.UserState UserState
@inject NavigationManager NavigationManager
@inject IFuncionesServiceClient FuncionesService
@inject IPeliculasServiceClient PeliculasService
@inject ICinesServiceClient CinesService

<PageTitle>Gestión de Funciones - Admin</PageTitle>

@if (!UserState.IsAdmin)
{
    <div class="alert alert-danger m-5">Acceso denegado. No tienes permisos para ver esta página.</div>
}
else
{
    <div class="min-h-screen bg-background">
      <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
          <div>
            <h1 class="text-2xl text-foreground mb-2" style="font-size: 1.5rem; font-weight:bold;">Gestión de Funciones</h1>
            <p class="text-muted-foreground">Administra los horarios de proyección por sala y sede</p>
          </div>
          <button class="flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors" @onclick="() => AbrirModal()">
            <i class="bi bi-plus-lg"></i>
            Nueva Función
          </button>
        </div>

        @if (!string.IsNullOrEmpty(errorListado))
        {
            <div class="alert alert-danger">@errorListado</div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-danger" role="status"></div>
                <p class="mt-3">Cargando funciones...</p>
            </div>
        }
        else
        {
            <div class="bg-card rounded-lg shadow-sm border border-border overflow-x-auto">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Película</th>
                            <th>Sede</th>
                            <th>Sala</th>
                            <th>Fecha y hora</th>
                            <th>Formato</th>
                            <th>Precio base</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in funciones.OrderBy(f => f.FechaHora))
                        {
                            <tr>
                                <td>@(f.Pelicula?.Titulo ?? "—")</td>
                                <td>@(f.Sala?.Cine?.Nombre ?? "—")</td>
                                <td>Sala @(f.Sala?.Numero ?? 0)</td>
                                <td>@f.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@f.Formato</td>
                                <td>S/ @f.PrecioBase.ToString("N2")</td>
                                <td class="text-end">
                                    <button class="p-2 text-foreground dark:text-white hover:bg-muted dark:hover:bg-gray-700 rounded-md transition-colors" @onclick="() => AbrirModal(f)"><i class="bi bi-pencil"></i></button>
                                    <button class="p-2 text-destructive hover:bg-destructive/10 rounded-md transition-colors text-danger" @onclick="() => Eliminar(f)"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
      </div>
    </div>

    @if (modalAbierto)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered text-body">
                <div class="modal-content bg-card">
                    <div class="modal-header border-border">
                        <h5 class="modal-title fw-bold text-foreground">@(editando ? "Editar Función" : "Nueva Función")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-body">Película</label>
                            <select class="form-select bg-body-tertiary text-body border-secondary" @bind="idPeliculaSeleccionada">
                                <option value="0">-- Selecciona una película --</option>
                                @foreach (var p in peliculas)
                                {
                                    <option value="@p.Id">@p.Titulo</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-body">Sede</label>
                            <select class="form-select bg-body-tertiary text-body border-secondary" @bind="idCineSeleccionado" @bind:after="CargarSalasDeLaSede">
                                <option value="0">-- Selecciona una sede --</option>
                                @foreach (var c in cines)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-body">Sala</label>
                            <select class="form-select bg-body-tertiary text-body border-secondary" @bind="idSalaSeleccionada">
                                <option value="0">-- Selecciona una sala --</option>
                                @foreach (var s in salasDeLaSede)
                                {
                                    <option value="@s.Id">Sala @s.Numero (cap. @s.Capacidad)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-body">Fecha y hora</label>
                            <input type="datetime-local" class="form-control bg-body-tertiary text-body border-secondary" @bind="fechaHora" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-body">Formato</label>
                            <select class="form-select bg-body-tertiary text-body border-secondary" @bind="formatoSeleccionado">
                                <option value="DosD">2D</option>
                                <option value="tresD">3D</option>
                                <option value="IMAX">IMAX</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-body">Precio base (S/)</label>
                            <input type="number" step="0.01" class="form-control bg-body-tertiary text-body border-secondary" @bind="precioBase" />
                        </div>
                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger">@errorMsg</div>
                        }
                    </div>
                    <div class="modal-footer border-border">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="button" class="btn btn-danger" @onclick="Guardar" disabled="@guardando">
                            @if (guardando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Guardar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<FuncionViewModel> funciones = new();
    private List<PeliculaViewModel> peliculas = new();
    private List<CineViewModel> cines = new();
    private List<SalaViewModel> salasDeLaSede = new();
    private bool isLoading = true;
    private bool guardando = false;
    private string errorMsg = "";
    private string errorListado = "";

    private bool modalAbierto = false;
    private bool editando = false;
    private int idFuncionEditando;

    private int idPeliculaSeleccionada;
    private int idCineSeleccionado;
    private int idSalaSeleccionada;
    private DateTime fechaHora = DateTime.Now.AddDays(1);
    private string formatoSeleccionado = "DosD";
    private double precioBase = 20.0;

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsAdmin)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        try
        {
            peliculas = await PeliculasService.ListarAsync();
            cines = await CinesService.ListarAsync();
        }
        catch { peliculas = new(); cines = new(); }

        await CargarFunciones();
    }

    private async Task CargarFunciones()
    {
        isLoading = true;
        errorListado = "";
        try
        {
            funciones = await FuncionesService.ListarAsync();
        }
        catch (Exception ex)
        {
            errorListado = "No se pudieron cargar las funciones: " + ex.Message;
            funciones = new();
        }
        isLoading = false;
    }

    private async Task CargarSalasDeLaSede()
    {
        salasDeLaSede = idCineSeleccionado > 0
            ? await CinesService.ListarSalasPorCineAsync(idCineSeleccionado)
            : new();
        idSalaSeleccionada = 0;
    }

    private async void AbrirModal(FuncionViewModel? f = null)
    {
        errorMsg = "";
        if (f != null)
        {
            editando = true;
            idFuncionEditando = f.Id;
            idPeliculaSeleccionada = f.Pelicula?.Id ?? 0;
            idCineSeleccionado = f.Sala?.Cine?.Id ?? 0;
            idSalaSeleccionada = f.Sala?.Id ?? 0;
            fechaHora = f.FechaHora;
            formatoSeleccionado = f.Formato ?? "DosD";
            precioBase = f.PrecioBase;
            salasDeLaSede = idCineSeleccionado > 0
                ? await CinesService.ListarSalasPorCineAsync(idCineSeleccionado)
                : new();
        }
        else
        {
            editando = false;
            idFuncionEditando = 0;
            idPeliculaSeleccionada = 0;
            idCineSeleccionado = 0;
            idSalaSeleccionada = 0;
            fechaHora = DateTime.Now.AddDays(1);
            formatoSeleccionado = "DosD";
            precioBase = 20.0;
            salasDeLaSede = new();
        }
        modalAbierto = true;
        StateHasChanged();
    }

    private void CerrarModal() => modalAbierto = false;

    private async Task Guardar()
    {
        errorMsg = "";

        if (idPeliculaSeleccionada == 0 || idSalaSeleccionada == 0)
        {
            errorMsg = "Selecciona película y sala antes de guardar.";
            return;
        }

        var funcion = new FuncionViewModel
        {
            Id = idFuncionEditando,
            FechaHora = fechaHora,
            PrecioBase = precioBase,
            Formato = formatoSeleccionado,
            Pelicula = new PeliculaViewModel { Id = idPeliculaSeleccionada },
            Sala = new SalaViewModel { Id = idSalaSeleccionada }
        };

        guardando = true;
        try
        {
            if (editando)
            {
                var ok = await FuncionesService.ActualizarAsync(idFuncionEditando, funcion);
                if (ok)
                {
                    CerrarModal();
                    await CargarFunciones();
                }
                else
                {
                    errorMsg = "Error al actualizar la función.";
                }
            }
            else
            {
                var creada = await FuncionesService.CrearAsync(funcion);
                if (creada != null)
                {
                    CerrarModal();
                    await CargarFunciones();
                }
                else
                {
                    errorMsg = "Error al crear la función.";
                }
            }
        }
        catch (Exception ex)
        {
            // El backend valida cruces de horario por sala y otras reglas de negocio,
            // devolviendo el motivo exacto en el mensaje de error (ver BUG-017 en la bitácora).
            errorMsg = ex.Message;
        }
        guardando = false;
    }

    private async Task Eliminar(FuncionViewModel f)
    {
        var ok = await FuncionesService.EliminarAsync(f.Id);
        if (ok) funciones.Remove(f);
    }
}
