@page "/movies/{MovieId}/seats/{FuncionId}"
@using CineFlow.Web.Servicios.Catalogo
@using CineFlow.Web.Servicios.Reserva
@using CineFlow.Web.ViewModels.Catalogo
@inject NavigationManager NavigationManager
@inject IFuncionesServiceClient FuncionesService
@inject BookingState BookingState
@inject IReservasServiceClient ReservasService
@inject CineFlow.Web.Servicios.User.UserState UserState

<PageTitle>Selección de Asientos - CineFlow</PageTitle>

<div class="container py-5 text-body">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Cargando mapa de asientos...</p>
        </div>
    }
    else if (Funcion == null)
    {
        <p><em>Función no encontrada.</em></p>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Selecciona tus Asientos</h2>
            <CancelReservation MovieId="@MovieId" />
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="bg-body p-4 rounded shadow">
                    <div class="screen bg-secondary mb-5 py-2 text-center rounded text-dark fw-bold">PANTALLA</div>
                    
                    <div class="d-flex flex-column align-items-center">
                        @foreach(var filaGroup in Asientos.GroupBy(a => a.Fila))
                        {
                            <div class="d-flex justify-content-center mb-2">
                                <span class="me-3 fw-bold mt-2" style="width: 20px;">@filaGroup.Key</span>
                                @foreach(var asiento in filaGroup)
                                {
                                    <button 
                                        class="btn btn-sm mx-1 @GetSeatClass(asiento)" 
                                        style="width: 40px; height: 40px;"
                                        disabled="@(asiento.Estado != "DISPONIBLE")"
                                        @onclick="() => ToggleSeat(asiento)">
                                        @asiento.Numero
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-center mt-5 gap-4">
                        <div class="d-flex align-items-center"><div class="btn btn-outline-light btn-sm me-2" style="width:30px;height:30px;"></div>Disponible</div>
                        <div class="d-flex align-items-center"><div class="btn btn-danger btn-sm me-2" style="width:30px;height:30px;"></div>Seleccionado</div>
                        <div class="d-flex align-items-center"><div class="btn btn-secondary btn-sm me-2" style="width:30px;height:30px;" disabled></div>Ocupado</div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card bg-body-tertiary text-body border-danger mb-3">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Resumen de Selección</h5>
                        <hr class="border-danger" />
                        <p><strong>Película:</strong> @Funcion.Pelicula.Titulo</p>
                        <p><strong>Fecha y Hora:</strong> @Funcion.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Sala:</strong> @Funcion.Sala.Numero</p>
                        <hr class="border-danger" />
                        <h6>Asientos Seleccionados:</h6>
                        @if (!BookingState.SelectedSeats.Any())
                        {
                            <p class="text-body-secondary small">Ningún asiento seleccionado.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled">
                                @foreach(var sId in BookingState.SelectedSeats)
                                {
                                    var asientoLabel = Asientos.FirstOrDefault(a => a.IdAsiento == sId)?.Label ?? sId.ToString();
                                    <li>Asiento @asientoLabel - S/ @Funcion.PrecioBase</li>
                                }
                            </ul>
                            <h5 class="fw-bold mt-3 text-danger">Total: S/ @(BookingState.SelectedSeats.Count * Funcion.PrecioBase)</h5>
                        }
                    </div>
                </div>

                <button class="btn btn-danger w-100 fw-bold py-2" disabled="@(!BookingState.SelectedSeats.Any() || isSaving)" @onclick="GoToTicketType">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Continuar a Tipos de Entrada
                </button>
                @if (!string.IsNullOrEmpty(seatError))
                {
                    <div class="alert alert-danger mt-2 p-2 small">@seatError</div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string MovieId { get; set; }
    
    [Parameter]
    public string FuncionId { get; set; }

    private FuncionViewModel Funcion;
    private List<AsientoViewModel> Asientos = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string seatError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsLoggedIn)
        {
            NavigationManager.NavigateTo($"/login?returnUrl=/movies/{MovieId}/seats/{FuncionId}", forceLoad: false);
            return;
        }

        // Usuario retrocedió desde Payment (reserva ya creada) → cancelarla
        if (BookingState.IdReserva > 0)
        {
            try { await ReservasService.CancelarReservaAsync(BookingState.IdReserva); } catch { }
            BookingState.IdReserva = 0;
        }
        // Usuario retrocedió desde TicketType/Snacks (solo pre-reserva) → liberar asientos
        else if (BookingState.PreReservedSeats.Any())
        {
            try { await ReservasService.LiberarAsientosAsync(BookingState.PreReservedSeats); } catch { }
        }

        BookingState.PreReservedSeats.Clear();
        BookingState.SelectedSeats.Clear();
        BookingState.TicketTypes.Clear();
        BookingState.SelectedSnacks.Clear();

        try
        {
            if (int.TryParse(FuncionId, out int id))
            {
                Funcion = await FuncionesService.ObtenerAsync(id);
                if (Funcion != null)
                {
                    Asientos = await FuncionesService.ListarAsientosAsync(id);
                    Funcion.MapaAsientos = Asientos;
                    BookingState.CurrentFuncion = Funcion;
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetSeatClass(AsientoViewModel asiento)
    {
        if (asiento.Estado == "RESERVADO") return "btn-secondary";
        if (asiento.Estado != "DISPONIBLE") return "btn-secondary";
        if (BookingState.SelectedSeats.Contains(asiento.IdAsiento)) return "btn-danger text-white";
        return "btn-outline-secondary";
    }

    private void ToggleSeat(AsientoViewModel asiento)
    {
        if (asiento.Estado != "DISPONIBLE") return;

        if (BookingState.SelectedSeats.Contains(asiento.IdAsiento))
        {
            BookingState.SelectedSeats.Remove(asiento.IdAsiento);
        }
        else
        {
            BookingState.SelectedSeats.Add(asiento.IdAsiento);
        }
    }

    private async Task GoToTicketType()
    {
        isSaving = true;
        seatError = string.Empty;

        var ok = await ReservasService.PreReservarAsientosAsync(BookingState.SelectedSeats);
        if (!ok)
        {
            seatError = "Uno o más asientos ya fueron reservados por otra persona. Selecciona otros.";
            // Refrescar el mapa para mostrar los asientos actualizados
            if (int.TryParse(FuncionId, out int id))
                Asientos = await FuncionesService.ListarAsientosAsync(id);
            BookingState.SelectedSeats.Clear();
            isSaving = false;
            return;
        }

        BookingState.PreReservedSeats = new List<int>(BookingState.SelectedSeats);

        // Inicializar tipos de entrada para los asientos seleccionados
        foreach (var seat in BookingState.SelectedSeats)
        {
            if (!BookingState.TicketTypes.ContainsKey(seat))
                BookingState.TicketTypes[seat] = "REGULAR";
        }

        NavigationManager.NavigateTo($"/movies/{MovieId}/seats/{FuncionId}/ticket-type");
    }
}
