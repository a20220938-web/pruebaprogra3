@page "/"
@page "/movies"
@using CineFlow.Web.Servicios.Catalogo
@using CineFlow.Web.ViewModels.Catalogo
@inject IPeliculasServiceClient PeliculasService
@inject ICinesServiceClient CinesService
@inject IFuncionesServiceClient FuncionesService

<PageTitle>Cartelera - CineFlow</PageTitle>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-body m-0">Cartelera Actual</h2>
    </div>

    <!-- Panel de Búsqueda y Filtros -->
    <div class="bg-black p-4 rounded-4 shadow-sm border border-secondary border-opacity-25 mb-5">
        <!-- Fila 1: Búsqueda y Ordenamiento -->
        <div class="row g-3 mb-3">
            <div class="col-md-9">
                <div class="input-group input-group-lg" title="Escribe el nombre de la película que buscas">
                    <span class="input-group-text bg-body border-secondary text-danger"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-body-tertiary text-body border-secondary" placeholder="Busca tu película favorita..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-lg bg-body-tertiary text-body border-secondary" @bind="selectedSort">
                    <option value="Titulo">A - Z</option>
                    <option value="TituloDesc">Z - A</option>
                    <option value="DuracionAsc">Más Cortas</option>
                    <option value="DuracionDesc">Más Largas</option>
                </select>
            </div>
        </div>

        <!-- Fila 2: Filtros Avanzados -->
        <div class="row g-3">
            <div class="col-md-2">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Sede</label>
                <select class="form-select bg-body-tertiary text-body border-secondary" @bind="selectedCineId" @bind:after="CargarPeliculas">
                    <option value="">Todas las Sedes</option>
                    @foreach (var cine in CinesDisponibles)
                    {
                        <option value="@cine.Nombre">@cine.Nombre?.Replace("CineFlow ", "")</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-calendar-event text-danger me-1"></i>Fecha</label>
                <select class="form-select bg-body-tertiary text-body border-secondary" @bind="selectedDateFilter">
                    <option value="">Todas</option>
                    <option value="Hoy">Hoy (@DateTime.Now.ToString("dd/MM"))</option>
                    <option value="Manana">Mañana (@DateTime.Now.AddDays(1).ToString("dd/MM"))</option>
                    <option value="Pasado">Pasado (@DateTime.Now.AddDays(2).ToString("dd/MM"))</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-film text-danger me-1"></i>Género</label>
                <select class="form-select bg-body-tertiary text-body border-secondary" @bind="selectedGenero">
                    <option value="">Todos los Géneros</option>
                    @foreach (var gen in GenerosUnicos)
                    {
                        <option value="@gen">@gen</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-person-badge text-danger me-1"></i>Clasificación</label>
                <select class="form-select bg-body-tertiary text-body border-secondary" @bind="selectedClasificacion">
                    <option value="">Cualquiera</option>
                    <option value="ATP">Apto para Todos (ATP)</option>
                    <option value="+13">Mayores de 13</option>
                    <option value="+16">Mayores de 16</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-hourglass-split text-danger me-1"></i>Duración Máx: @(maxDuracion) min</label>
                <input type="range" class="form-range" min="60" max="300" step="5" @bind="maxDuracion" @bind:event="oninput" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button class="btn btn-outline-danger w-100" @onclick="LimpiarFiltros" title="Limpiar filtros">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-body mt-3">Cargando la mejor cartelera...</p>
        </div>
    }
    else if (!PeliculasFiltradas.Any())
    {
        <div class="alert alert-secondary text-center mt-5 py-5 border-secondary">
            <i class="bi bi-camera-reels text-muted display-1 mb-3"></i>
            <h4 class="text-body fw-bold">No se encontraron películas</h4>
            <p class="text-body">Intenta aflojar algunos filtros o buscar con otro término.</p>
            <button class="btn btn-outline-danger mt-2" @onclick="LimpiarFiltros">Limpiar Filtros</button>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach(var pelicula in PeliculasFiltradas)
            {
                <div class="col">
                    <div class="card h-100 shadow-lg border-0 bg-body-tertiary text-body hover-zoom rounded-4 overflow-hidden" style="transition: transform 0.3s, box-shadow 0.3s;">
                        <div class="position-relative">
                            <img src="https://picsum.photos/400/600?random=@pelicula.Id" class="card-img-top" alt="@pelicula.Titulo" style="height: 380px; object-fit: cover;">
                            <div class="position-absolute top-0 end-0 m-2 badge bg-danger fs-6 rounded-pill">
                                @pelicula.EdadRestriccion
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-body mb-1">@pelicula.Titulo</h5>
                            @{
                                var cinesAsociados = TodasLasFunciones.Where(f => f.Pelicula?.Id == pelicula.Id && f.Sala?.Cine?.Nombre != null).Select(f => f.Sala!.Cine!.Nombre).Distinct().ToList();
                                var cinesText = cinesAsociados.Any() ? string.Join(", ", cinesAsociados) : "Varias sedes";
                            }
                            <p class="text-body small mb-2"><i class="bi bi-geo-alt me-1"></i>@cinesText</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-secondary text-light">@pelicula.Genero</span>
                                <small class="text-body"><i class="bi bi-clock me-1"></i>@pelicula.Duracion min</small>
                            </div>
                            <a href="/movies/@pelicula.Id" class="btn btn-danger w-100 mt-auto rounded-pill fw-bold">Ver Funciones</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-zoom:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(220, 53, 69, 0.2) !important;
    }
</style>

@code {
    private List<PeliculaViewModel> Peliculas = new();
    private List<CineViewModel> CinesDisponibles = new();
    private List<FuncionViewModel> TodasLasFunciones = new();
    private List<string> GenerosUnicos = new();
    private bool cargando = true;

    // Filtros
    private string searchTerm = "";
    private string selectedCineId = "";
    private string selectedDateFilter = "";
    private string selectedGenero = "";
    private string selectedClasificacion = "";
    private int maxDuracion = 300;
    private string selectedSort = "Titulo";

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        await Task.WhenAll(CargarPeliculas(), CargarCines(), CargarFunciones());
        cargando = false;
        StateHasChanged(); 
    }

    private async Task CargarFunciones()
    {
        TodasLasFunciones = await FuncionesService.ListarAsync() ?? new List<FuncionViewModel>();
    }

    private async Task CargarCines()
    {
        CinesDisponibles = await CinesService.ListarAsync() ?? new List<CineViewModel>();
    }

    private async Task CargarPeliculas()
    {
        Peliculas = await PeliculasService.ListarAsync() ?? new List<PeliculaViewModel>();
        GenerosUnicos = Peliculas.Where(p => p.Genero != null).Select(p => p.Genero!).Distinct().OrderBy(g => g).ToList();
    }

    private async Task LimpiarFiltros()
    {
        searchTerm = "";
        selectedCineId = "";
        selectedDateFilter = "";
        selectedGenero = "";
        selectedClasificacion = "";
        maxDuracion = 300;
        selectedSort = "Titulo";
        await CargarPeliculas();
    }

    private IEnumerable<PeliculaViewModel> PeliculasFiltradas 
    {
        get
        {
            var query = Peliculas.AsEnumerable();

            // Ocultar películas antiguas: solo mostrar las que tienen al menos una función hoy o en el futuro
            var hoy = DateTime.Now.Date;
            var idsPeliculasVigentes = (TodasLasFunciones ?? new())
                .Where(f => f.FechaHora >= hoy && f.Pelicula != null)
                .Select(f => f.Pelicula.Id)
                .ToHashSet();

            query = query.Where(p => idsPeliculasVigentes.Contains(p.Id));

            // Filtrar por Nombre
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(p => p.Titulo?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true);
            }

            // Filtrar por Sede
            if (!string.IsNullOrEmpty(selectedCineId))
            {
                var idsPeliculasSede = (TodasLasFunciones ?? new())
                    .Where(f => f.Sala?.Cine?.Nombre != null && f.Sala.Cine.Nombre.Equals(selectedCineId, StringComparison.OrdinalIgnoreCase) && f.Pelicula != null)
                    .Select(f => f.Pelicula.Id)
                    .ToHashSet();

                query = query.Where(p => idsPeliculasSede.Contains(p.Id));
            }

            // Filtrar por Fecha usando funciones reales de la BD
            if (!string.IsNullOrEmpty(selectedDateFilter))
            {
                DateTime? targetDate = null;
                if (selectedDateFilter == "Hoy") targetDate = DateTime.Now.Date;
                else if (selectedDateFilter == "Manana") targetDate = DateTime.Now.Date.AddDays(1);
                else if (selectedDateFilter == "Pasado") targetDate = DateTime.Now.Date.AddDays(2);

                if (targetDate.HasValue)
                {
                    var idsPeliculas = (TodasLasFunciones ?? new())
                        .Where(f => f.FechaHora.Date == targetDate.Value && f.Pelicula != null)
                        .Select(f => f.Pelicula.Id)
                        .ToHashSet();

                    query = query.Where(p => idsPeliculas.Contains(p.Id));
                }
            }            // Filtrar por Género
            if (!string.IsNullOrEmpty(selectedGenero))
            {
                query = query.Where(p => p.Genero?.Equals(selectedGenero, StringComparison.OrdinalIgnoreCase) == true);
            }

            // Filtrar por Clasificación (Censura)
            if (!string.IsNullOrEmpty(selectedClasificacion))
            {
                query = query.Where(p => p.EdadRestriccion?.Equals(selectedClasificacion, StringComparison.OrdinalIgnoreCase) == true);
            }

            // Filtrar por Duración Máxima
            query = query.Where(p => p.Duracion <= maxDuracion);

            // Ordenamiento
            switch (selectedSort)
            {
                case "DuracionAsc":
                    query = query.OrderBy(p => p.Duracion);
                    break;
                case "DuracionDesc":
                    query = query.OrderByDescending(p => p.Duracion);
                    break;
                case "TituloDesc":
                    query = query.OrderByDescending(p => p.Titulo);
                    break;
                case "Titulo":
                default:
                    query = query.OrderBy(p => p.Titulo);
                    break;
            }

            return query.ToList();
        }
    }
}
