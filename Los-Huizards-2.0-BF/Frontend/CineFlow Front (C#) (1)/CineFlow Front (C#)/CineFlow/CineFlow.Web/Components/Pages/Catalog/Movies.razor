@page "/"
@page "/movies"
@using CineFlow.Web.Servicios.Catalogo
@using CineFlow.Web.ViewModels.Catalogo
@inject IPeliculasServiceClient PeliculasService

<PageTitle>Cartelera - CineFlow</PageTitle>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-body m-0">Cartelera Actual</h2>
    </div>

    <!-- Panel de Búsqueda y Filtros -->
    <div class="bg-black p-4 rounded-4 shadow-sm border border-secondary border-opacity-25 mb-5">
        <!-- Fila 1: Búsqueda y Ordenamiento -->
        <div class="row g-3 mb-3">
            <div class="col-md-9">
                <div class="input-group input-group-lg" title="Escribe el nombre de la película que buscas">
                    <span class="input-group-text bg-body border-secondary text-danger"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-body-tertiary text-body border-secondary" placeholder="Busca tu película favorita..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-lg bg-body-tertiary text-body border-secondary" @bind="selectedSort">
                    <option value="Titulo">A - Z</option>
                    <option value="TituloDesc">Z - A</option>
                    <option value="DuracionAsc">Más Cortas</option>
                    <option value="DuracionDesc">Más Largas</option>
                </select>
            </div>
        </div>

        <!-- Fila 2: Filtros Avanzados -->
        <div class="row g-3">
            <div class="col-md-2">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Sede</label>
                <select class="form-select bg-body-tertiary text-body border-secondary" @bind="selectedCineId">
                    <option value="">Todas las Sedes</option>
                    @foreach (var cine in CinesDisponibles)
                    {
                        <option value="@cine.Id">@cine.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-calendar-event text-danger me-1"></i>Fecha</label>
                <input type="date" class="form-control bg-body-tertiary text-body border-secondary" @bind="selectedDate" />
            </div>
            <div class="col-md-3">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-film text-danger me-1"></i>Género</label>
                <select class="form-select bg-body-tertiary text-body border-secondary" @bind="selectedGenero">
                    <option value="">Todos los Géneros</option>
                    @foreach (var gen in GenerosUnicos)
                    {
                        <option value="@gen">@gen</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-person-badge text-danger me-1"></i>Censura</label>
                <select class="form-select bg-body-tertiary text-body border-secondary" @bind="selectedClasificacion">
                    <option value="">Cualquiera</option>
                    <option value="ATP">Apto para Todos (ATP)</option>
                    <option value="+13">Mayores de 13</option>
                    <option value="+16">Mayores de 16</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="text-light fw-semibold small mb-1"><i class="bi bi-hourglass-split text-danger me-1"></i>Duración Máx: @(maxDuracion) min</label>
                <input type="range" class="form-range" min="60" max="180" step="5" @bind="maxDuracion" @bind:event="oninput" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button class="btn btn-outline-danger w-100" @onclick="LimpiarFiltros" title="Limpiar filtros">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        </div>
    </div>

    @if (Peliculas == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-body mt-3">Cargando la mejor cartelera...</p>
        </div>
    }
    else if (!PeliculasFiltradas.Any())
    {
        <div class="alert alert-dark text-center mt-5 py-5 border-secondary">
            <i class="bi bi-camera-reels text-muted display-1 mb-3"></i>
            <h4 class="text-body">No se encontraron películas</h4>
            <p class="text-muted">Intenta aflojar algunos filtros o buscar con otro término.</p>
            <button class="btn btn-outline-danger mt-2" @onclick="LimpiarFiltros">Limpiar Filtros</button>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach(var pelicula in PeliculasFiltradas)
            {
                <div class="col">
                    <div class="card h-100 shadow-lg border-0 bg-body-tertiary text-body hover-zoom rounded-4 overflow-hidden" style="transition: transform 0.3s, box-shadow 0.3s;">
                        <div class="position-relative">
                            <img src="https://picsum.photos/400/600?random=@pelicula.Id" class="card-img-top" alt="@pelicula.Titulo" style="height: 380px; object-fit: cover;">
                            <div class="position-absolute top-0 end-0 m-2 badge bg-danger fs-6 rounded-pill">
                                @pelicula.EdadRestriccion
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-body mb-1">@pelicula.Titulo</h5>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-secondary text-light">@pelicula.Genero</span>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@pelicula.Duracion min</small>
                            </div>
                            <a href="/movies/@pelicula.Id" class="btn btn-danger w-100 mt-auto rounded-pill fw-bold">Ver Funciones</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-zoom:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(220, 53, 69, 0.2) !important;
    }
</style>

@code {
    private List<PeliculaViewModel> Peliculas;
    // CinesDisponibles can be populated later
    private List<CineViewModel> CinesDisponibles = new();
    private List<string> GenerosUnicos = new();

    // Filtros
    private string searchTerm = "";
    private string selectedCineId = "";
    private DateTime? selectedDate = null;
    private string selectedGenero = "";
    private string selectedClasificacion = "";
    private int maxDuracion = 180;
    private string selectedSort = "Titulo";

    protected override async Task OnInitializedAsync()
    {
        Peliculas = await PeliculasService.ListarAsync() ?? new List<PeliculaViewModel>();
        GenerosUnicos = Peliculas.Where(p => p.Genero != null).Select(p => p.Genero!).Distinct().OrderBy(g => g).ToList();
    }

    private void LimpiarFiltros()
    {
        searchTerm = "";
        selectedCineId = "";
        selectedDate = null;
        selectedGenero = "";
        selectedClasificacion = "";
        maxDuracion = 180;
        selectedSort = "Titulo";
    }

    private IEnumerable<PeliculaViewModel> PeliculasFiltradas 
    {
        get
        {
            var query = Peliculas.AsEnumerable();

            // Filtrar por Nombre
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(p => p.Titulo?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true);
            }

            // Omito filtro por sede y fecha local en memoria por simplicidad


            // Filtrar por Fecha - (Requeriría buscar funciones localmente, se deja sin implementar para mock local o se puede hacer API call)


            // Filtrar por Género
            if (!string.IsNullOrEmpty(selectedGenero))
            {
                query = query.Where(p => p.Genero?.Equals(selectedGenero, StringComparison.OrdinalIgnoreCase) == true);
            }

            // Filtrar por Clasificación (Censura)
            if (!string.IsNullOrEmpty(selectedClasificacion))
            {
                query = query.Where(p => p.EdadRestriccion?.Equals(selectedClasificacion, StringComparison.OrdinalIgnoreCase) == true);
            }

            // Filtrar por Duración Máxima
            query = query.Where(p => p.Duracion <= maxDuracion);

            // Ordenamiento
            switch (selectedSort)
            {
                case "DuracionAsc":
                    query = query.OrderBy(p => p.Duracion);
                    break;
                case "DuracionDesc":
                    query = query.OrderByDescending(p => p.Duracion);
                    break;
                case "TituloDesc":
                    query = query.OrderByDescending(p => p.Titulo);
                    break;
                case "Titulo":
                default:
                    query = query.OrderBy(p => p.Titulo);
                    break;
            }

            return query.ToList();
        }
    }
}
