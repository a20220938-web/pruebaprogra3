@page "/admin/ventas"
@using CineFlow.Web.Servicios.Catalogo
@using CineFlow.Web.ViewModels.Catalogo
@inject CineFlow.Web.Servicios.User.UserState UserState
@inject NavigationManager NavigationManager
@inject IPeliculasServiceClient PeliculasService
@inject IReportesServiceClient ReportesService
@inject IJSRuntime JSRuntime

<PageTitle>Reporte de Ventas - Admin</PageTitle>

@if (!UserState.IsAdmin)
{
    <div class="alert alert-danger m-5">Acceso denegado. No tienes permisos para ver esta página.</div>
}
else
{
    <div class="min-h-screen bg-background">
      <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="bg-card rounded-lg shadow-lg border border-border p-6 mb-6">
          <h1 class="text-2xl text-foreground mb-2" style="font-size: 1.5rem; font-weight:bold;">Reporte de ventas por película</h1>
          <p class="text-muted-foreground" style="color:gray;">
            Panel administrativo - Análisis de ventas y recaudación
          </p>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-danger" role="status"></div>
                <p class="mt-3">Cargando reporte...</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
              <div class="bg-card rounded-lg shadow-lg border border-border p-6">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-sm text-muted-foreground">Total de entradas vendidas</h3>
                  <i class="bi bi-ticket-perforated text-danger fs-4"></i>
                </div>
                <p class="text-3xl text-foreground" style="font-size: 2rem; font-weight:bold;">@totalEntradas.ToString("N0")</p>
              </div>

              <div class="bg-card rounded-lg shadow-lg border border-border p-6">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-sm text-muted-foreground">Recaudación total</h3>
                  <i class="bi bi-graph-up-arrow text-success fs-4"></i>
                </div>
                <p class="text-3xl text-foreground" style="font-size: 2rem; font-weight:bold;">S/ @totalRecaudacion.ToString("N2")</p>
              </div>

              <div class="bg-card rounded-lg shadow-lg border border-border p-6">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-sm text-muted-foreground">Películas en reporte</h3>
                  <i class="bi bi-film text-primary fs-4"></i>
                </div>
                <p class="text-3xl text-foreground" style="font-size: 2rem; font-weight:bold;">@reporteData.Count</p>
              </div>
            </div>

            <div class="bg-card rounded-lg shadow-lg border border-border overflow-hidden">
              <div class="p-6 border-b border-border flex items-center justify-between">
                <h2 class="text-lg text-foreground" style="font-size: 1.25rem; font-weight:bold;">Detalle por película</h2>
                <button class="flex items-center gap-2 px-4 py-2 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/90 transition-colors" @onclick="ExportarCSV">
                  <i class="bi bi-download"></i>
                  Exportar reporte
                </button>
              </div>

              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead class="bg-muted/30">
                    <tr>
                      <th class="px-6 py-3 text-left text-sm text-foreground">Película</th>
                      <th class="px-6 py-3 text-left text-sm text-foreground">Género</th>
                      <th class="px-6 py-3 text-right text-sm text-foreground">Entradas vendidas</th>
                      <th class="px-6 py-3 text-right text-sm text-foreground">Monto recaudado</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    @foreach (var item in reporteData)
                    {
                      <tr class="hover:bg-muted/20">
                        <td class="px-6 py-4 text-sm text-foreground">@item.Pelicula?.Titulo</td>
                        <td class="px-6 py-4 text-sm text-muted-foreground">@item.Pelicula?.Genero</td>
                        <td class="px-6 py-4 text-sm text-foreground text-right">@item.CantidadEntradasVendidas</td>
                        <td class="px-6 py-4 text-sm text-foreground text-right">S/ @item.MontoTotalRecaudado.ToString("N2")</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>
        }
      </div>
    </div>
}

@code {
    private List<ReporteVentasPeliculaViewModel> reporteData = new();
    private bool isLoading = true;
    private int totalEntradas;
    private double totalRecaudacion;

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsAdmin)
        {
            NavigationManager.NavigateTo("/");
            return;
        }
        await CargarReporte();
    }

    private async Task CargarReporte()
    {
        isLoading = true;
        var peliculas = await PeliculasService.ListarAsync();
        var reportes = new List<ReporteVentasPeliculaViewModel>();

        foreach (var peli in peliculas)
        {
            var reporte = await ReportesService.ObtenerVentasPorPeliculaAsync(peli.Id);
            if (reporte != null)
            {
                reporte.Pelicula ??= peli;
                reportes.Add(reporte);
            }
        }

        reporteData = reportes;
        totalEntradas = reporteData.Sum(x => x.CantidadEntradasVendidas);
        totalRecaudacion = reporteData.Sum(x => x.MontoTotalRecaudado);
        isLoading = false;
    }

    private async Task ExportarCSV()
    {
        var csv = "Película,Género,Entradas Vendidas,Monto Recaudado\n";
        foreach (var item in reporteData)
        {
            csv += $"\"{item.Pelicula?.Titulo}\",\"{item.Pelicula?.Genero}\",{item.CantidadEntradasVendidas},{item.MontoTotalRecaudado}\n";
        }
        await JSRuntime.InvokeVoidAsync("downloadFile", "ReporteVentas.csv", csv);
    }
}
