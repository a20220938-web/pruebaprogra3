@page "/admin/ventas"
@using CineFlow.Web.Servicios.Catalogo
@using CineFlow.Web.ViewModels.Catalogo
@inject CineFlow.Web.Servicios.User.UserState UserState
@inject NavigationManager NavigationManager
@inject IPeliculasServiceClient PeliculasService
@inject IReportesServiceClient ReportesService
@inject ICinesServiceClient CinesService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<PageTitle>Panel de Ventas - Admin</PageTitle>

@if (!UserState.IsAdmin)
{
    <div class="alert alert-danger m-5">Acceso denegado. No tienes permisos para ver esta página.</div>
}
else
{
  <div class="container py-4">
    <div class="mb-4">
      <h1 class="fw-bold mb-1" style="font-size:1.6rem;">Panel administrativo de ventas</h1>
      <p class="text-body-secondary mb-0">Resumen ejecutivo de la operación. El detalle por película está en el reporte PDF.</p>
    </div>

    <!-- ===== Filtros del reporte PDF ===== -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-12 col-md-4">
            <label class="form-label small fw-semibold"><i class="bi bi-geo-alt text-danger me-1"></i>Cine</label>
            <select class="form-select" @bind="filtroCine">
              <option value="">Todos los cines</option>
              @foreach (var c in cines)
              {
                <option value="@c.Id">@c.Nombre</option>
              }
            </select>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small fw-semibold">Desde</label>
            <input type="date" class="form-control" @bind="filtroDesde" />
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small fw-semibold">Hasta</label>
            <input type="date" class="form-control" @bind="filtroHasta" />
          </div>
          <div class="col-12 col-md-2 d-grid">
            <a href="@UrlReporteVentas" target="_blank" class="btn btn-danger">
              <i class="bi bi-file-earmark-pdf me-1"></i> PDF
            </a>
          </div>
        </div>
        <div class="form-text mt-2">Los filtros son opcionales. Si dejas un campo vacío, no se aplica ese filtro.</div>
      </div>
    </div>

    <!-- ===== Filtro por rango de fechas ===== -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body py-3">
        <div class="row align-items-end g-2">
          <div class="col-auto">
            <label class="form-label small fw-semibold mb-1">Fecha inicio</label>
            <input type="date" class="form-control form-control-sm" @bind="fechaInicio" />
          </div>
          <div class="col-auto">
            <label class="form-label small fw-semibold mb-1">Fecha fin</label>
            <input type="date" class="form-control form-control-sm" @bind="fechaFin" />
          </div>
          <div class="col-auto">
            <button class="btn btn-danger btn-sm fw-bold" @onclick="Filtrar">
              <i class="bi bi-funnel me-1"></i> Filtrar
            </button>
          </div>
        </div>
      </div>
    </div>

    @if (isLoading)
    {
      <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="mt-3">Cargando información...</p>
      </div>
    }
    else
    {
      <!-- ===== KPIs ejecutivos ===== -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
          <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="d-flex justify-content-between"><span class="text-body-secondary small">Recaudación total</span><i class="bi bi-cash-coin text-success"></i></div>
            <div class="fw-bold" style="font-size:1.7rem;">S/ @totalRecaudacion.ToString("N2")</div>
          </div></div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="d-flex justify-content-between"><span class="text-body-secondary small">Entradas vendidas</span><i class="bi bi-ticket-perforated text-danger"></i></div>
            <div class="fw-bold" style="font-size:1.7rem;">@totalEntradas.ToString("N0")</div>
          </div></div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="d-flex justify-content-between"><span class="text-body-secondary small">Ticket promedio</span><i class="bi bi-receipt text-primary"></i></div>
            <div class="fw-bold" style="font-size:1.7rem;">S/ @TicketPromedio.ToString("N2")</div>
          </div></div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="d-flex justify-content-between"><span class="text-body-secondary small">Películas con ventas</span><i class="bi bi-film text-warning"></i></div>
            <div class="fw-bold" style="font-size:1.7rem;">@PeliculasConVentas <span class="text-body-secondary" style="font-size:1rem;">/ @reporteData.Count</span></div>
          </div></div>
        </div>
      </div>

      <div class="row g-3">
        <!-- ===== Recaudación por género (vista de gestión, NO está en el PDF) ===== -->
        <div class="col-lg-6">
          <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-bold">Recaudación por género</div>
            <div class="card-body p-0">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr>
                  <th>Género</th><th class="text-end">Entradas</th><th class="text-end">Recaudación</th><th class="text-end">%</th>
                </tr></thead>
                <tbody>
                @if (porGenero.Count == 0)
                {
                  <tr><td colspan="4" class="text-center text-body-secondary py-3">Sin datos de ventas.</td></tr>
                }
                @foreach (var g in porGenero)
                {
                  <tr>
                    <td>@g.Genero</td>
                    <td class="text-end">@g.Entradas.ToString("N0")</td>
                    <td class="text-end">S/ @g.Recaudacion.ToString("N2")</td>
                    <td class="text-end">@Porcentaje(g.Recaudacion).ToString("N1")%</td>
                  </tr>
                }
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ===== Top películas por recaudación (resumen rápido) ===== -->
        <div class="col-lg-6">
          <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-bold">Top 5 películas por recaudación</div>
            <div class="card-body">
              @if (topPeliculas.Count == 0)
              {
                <p class="text-body-secondary mb-0">Sin datos de ventas.</p>
              }
              @foreach (var p in topPeliculas)
              {
                <div class="mb-3">
                  <div class="d-flex justify-content-between small mb-1">
                    <span class="fw-semibold text-truncate" style="max-width:65%;">@p.Pelicula?.Titulo</span>
                    <span>S/ @p.MontoTotalRecaudado.ToString("N2")</span>
                  </div>
                  <div class="progress" style="height:8px;">
                    <div class="progress-bar bg-danger" role="progressbar"
                         style="width:@(BarraPct(p.MontoTotalRecaudado))%;"></div>
                  </div>
                </div>
              }
            </div>
          </div>
        </div>
      </div>
    }
  </div>
}

@code {
    private string ReportesBase => Configuration["ReportesUrl"] ?? "http://localhost:8080/CineFlowReportes/reportes/";

    // ===== Filtros del reporte PDF =====
    private List<CineViewModel> cines = new();
    private string filtroCine = "";      // "" = todos los cines
    private DateOnly? filtroDesde;        // input type=date -> se envia como yyyy-MM-dd
    private DateOnly? filtroHasta;

    private string UrlReporteVentas
    {
        get
        {
            var qs = new List<string>();
            if (!string.IsNullOrWhiteSpace(filtroCine)) qs.Add($"idCine={filtroCine}");
            if (filtroDesde.HasValue) qs.Add($"desde={filtroDesde.Value:yyyy-MM-dd}");
            if (filtroHasta.HasValue) qs.Add($"hasta={filtroHasta.Value:yyyy-MM-dd}");
            return ReportesBase + "ventas-pelicula" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
        }
    }

    private List<ReporteVentasPeliculaViewModel> reporteData = new();
    private bool isLoading = true;
    private int totalEntradas;
    private double totalRecaudacion;

    private record GeneroResumen(string Genero, int Entradas, double Recaudacion);
    private List<GeneroResumen> porGenero = new();
    private List<ReporteVentasPeliculaViewModel> topPeliculas = new();

    private DateTime? fechaInicio = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime? fechaFin = DateTime.Now;

    private double TicketPromedio => totalEntradas > 0 ? totalRecaudacion / totalEntradas : 0;
    private int PeliculasConVentas => reporteData.Count(x => x.CantidadEntradasVendidas > 0);
    private double MaxRecaudacion => reporteData.Count > 0 ? reporteData.Max(x => x.MontoTotalRecaudado) : 0;

    private double Porcentaje(double monto) => totalRecaudacion > 0 ? monto / totalRecaudacion * 100 : 0;
    private double BarraPct(double monto) => MaxRecaudacion > 0 ? monto / MaxRecaudacion * 100 : 0;

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsAdmin)
        {
            NavigationManager.NavigateTo("/");
            return;
        }
        try { cines = await CinesService.ListarAsync(); } catch { cines = new(); }
        await CargarReporte();
    }

    private async Task Filtrar()
    {
        await CargarReporte();
    }

    private async Task CargarReporte()
    {
        isLoading = true;
        var peliculas = await PeliculasService.ListarAsync();
        var reportes = new List<ReporteVentasPeliculaViewModel>();

        foreach (var peli in peliculas)
        {
            var reporte = await ReportesService.ObtenerVentasPorPeliculaAsync(peli.Id, fechaInicio, fechaFin);
            if (reporte != null)
            {
                reporte.Pelicula ??= peli;
                reportes.Add(reporte);
            }
        }

        reporteData = reportes;
        totalEntradas = reporteData.Sum(x => x.CantidadEntradasVendidas);
        totalRecaudacion = reporteData.Sum(x => x.MontoTotalRecaudado);

        porGenero = reporteData
            .GroupBy(x => x.Pelicula?.Genero.ToString() ?? "Sin género")
            .Select(g => new GeneroResumen(g.Key,
                                           g.Sum(e => e.CantidadEntradasVendidas),
                                           g.Sum(e => e.MontoTotalRecaudado)))
            .OrderByDescending(g => g.Recaudacion)
            .ToList();

        topPeliculas = reporteData
            .OrderByDescending(x => x.MontoTotalRecaudado)
            .Take(5)
            .ToList();

        isLoading = false;
    }
}
