@page "/movies/{MovieId}/seats/{FuncionId}/ticket-type"
@using CineFlow.Web.Servicios.Reserva
@using CineFlow.Web.ViewModels.Catalogo
@inject NavigationManager NavigationManager
@inject BookingState BookingState
@inject CineFlow.Web.Servicios.User.UserState UserState

<PageTitle>Tipo de Entrada - CineFlow</PageTitle>

<div class="container py-5 text-body">
    <h2 class="fw-bold mb-4">Tipo de entrada</h2>
    <p class="text-muted mb-5">Selecciona el tipo de entrada para cada asiento</p>

    <div class="row">
        <div class="col-md-8">
            <div class="card bg-body-tertiary text-body border-secondary mb-4">
                <div class="card-body">
                    @foreach (var asientoId in SelectedSeatIds)
                    {
                        var asiento = Funcion?.MapaAsientos?.FirstOrDefault(a => a.IdAsiento == asientoId);
                        if (asiento != null)
                        {
                            var currentType = GetTicketType(asientoId);
                            <div class="border border-secondary p-4 rounded mb-3">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                    <div class="mb-3 mb-md-0">
                                        <h5 class="fw-bold mb-1">Asiento @asiento.Label</h5>
                                        <p class="text-muted small mb-0">Precio: S/ @GetPrice(currentType).ToString("0.00")</p>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn @(currentType == "REGULAR" ? "btn-danger" : "btn-outline-light")" @onclick="@(() => SetTicketType(asientoId, "REGULAR"))">
                                            Regular <br/><small>S/ @GetPrice("REGULAR").ToString("0.00")</small>
                                        </button>
                                        <button class="btn @(currentType == "NIÑO" ? "btn-danger" : "btn-outline-light")" @onclick="@(() => SetTicketType(asientoId, "NIÑO"))">
                                            Niño <br/><small>S/ @GetPrice("NIÑO").ToString("0.00") (30% dto.)</small>
                                        </button>
                                        <button class="btn @(currentType == "CONADIS" ? "btn-danger" : "btn-outline-light")" @onclick="@(() => SetTicketType(asientoId, "CONADIS"))">
                                            CONADIS <br/><small>S/ @GetPrice("CONADIS").ToString("0.00") (50% dto.)</small>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-body-tertiary text-body border-danger sticky-top" style="top: 20px;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold">Total</h4>
                        <h4 class="text-danger fw-bold">S/ @GetTotal().ToString("0.00")</h4>
                    </div>

                    <button class="btn btn-danger w-100 fw-bold py-3" @onclick="GoToSnacks">
                        Continuar
                    </button>
                    <button class="btn btn-outline-light w-100 fw-bold py-2 mt-2" @onclick="GoBack">
                        Regresar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string MovieId { get; set; }

    [Parameter]
    public string FuncionId { get; set; }

    private FuncionViewModel? Funcion;
    private List<int> SelectedSeatIds = new();

    protected override void OnInitialized()
    {
        if (!UserState.IsLoggedIn)
        {
            NavigationManager.NavigateTo($"/login?returnUrl=/movies/{MovieId}/seats/{FuncionId}/ticket-type", forceLoad: false);
            return;
        }
        Funcion = BookingState.CurrentFuncion;
        
        // Obtener del estado central
        SelectedSeatIds = BookingState.SelectedSeats;
        
        // Limpiar tipos de entradas para asientos que ya no están seleccionados
        var currentKeys = BookingState.TicketTypes.Keys.ToList();
        foreach (var key in currentKeys)
        {
            if (!SelectedSeatIds.Contains(key))
            {
                BookingState.TicketTypes.Remove(key);
            }
        }
    }

    private string GetTicketType(int asientoId)
    {
        return BookingState.TicketTypes.ContainsKey(asientoId) ? BookingState.TicketTypes[asientoId] : "REGULAR";
    }

    private void SetTicketType(int asientoId, string type)
    {
        BookingState.TicketTypes[asientoId] = type;
    }

    private double GetPrice(string type)
    {
        var basePrice = Funcion?.PrecioBase ?? 0;
        return type switch
        {
            "NIÑO" => basePrice * 0.7,
            "CONADIS" => basePrice * 0.5,
            _ => basePrice
        };
    }

    private double GetTotal()
    {
        double total = 0;
        foreach (var seat in SelectedSeatIds)
        {
            total += GetPrice(GetTicketType(seat));
        }
        return total;
    }

    private void GoToSnacks()
    {
        NavigationManager.NavigateTo($"/movies/{MovieId}/seats/{FuncionId}/snacks");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo($"/movies/{MovieId}/seats/{FuncionId}");
    }
}
