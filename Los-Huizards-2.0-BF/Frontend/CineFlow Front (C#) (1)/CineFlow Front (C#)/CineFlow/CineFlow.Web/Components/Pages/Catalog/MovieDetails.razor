@page "/movies/{Id}"
@using CineFlow.Web.Servicios.Catalogo
@using CineFlow.Web.ViewModels.Catalogo
@inject NavigationManager NavigationManager
@inject IPeliculasServiceClient PeliculasService
@inject IFuncionesServiceClient FuncionesService

<PageTitle>Detalles de Película - CineFlow</PageTitle>

<div class="container py-5">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-body fs-5">Cargando detalles y funciones...</p>
        </div>
    }
    else if (Pelicula == null)
    {
        <p class="text-body"><em>Película no encontrada.</em></p>
    }
    else
    {
        <div class="row mb-5">
            <div class="col-md-4">
                <img src="https://picsum.photos/400/600?random=@Pelicula.Id" class="img-fluid rounded shadow" alt="@Pelicula.Titulo">
            </div>
            <div class="col-md-8 text-body">
                <h1 class="fw-bold mb-3">@Pelicula.Titulo</h1>
                <p class="lead">@Pelicula.Sinopsis</p>
                <ul class="list-unstyled">
                    <li><strong>Género:</strong> @Pelicula.Genero</li>
                    <li><strong>Duración:</strong> @Pelicula.Duracion minutos</li>
                    <li><strong>Clasificación:</strong> @Pelicula.EdadRestriccion</li>
                </ul>
            </div>
        </div>

        <h3 class="fw-bold text-body mb-4">Funciones Disponibles</h3>
        @if (!Funciones.Any())
        {
            <p class="text-body"><em>No hay funciones programadas para esta película.</em></p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach(var funcion in Funciones)
                {
                    <div class="col">
                        <div class="card h-100 bg-body-tertiary text-body border-secondary">
                            <div class="card-body">
                                <h5 class="card-title text-danger fw-bold">Sala @(funcion.Sala?.Numero) - @funcion.Formato</h5>
                                <p class="card-text">
                                    <strong>Fecha:</strong> @funcion.FechaHora.ToString("dd/MM/yyyy HH:mm")<br />
                                    <strong>Precio Base:</strong> S/ @funcion.PrecioBase<br />
                                </p>
                                <button class="btn btn-outline-danger w-100" @onclick="() => SelectFuncion(funcion.Id)">
                                    Seleccionar Asientos
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; }

    private PeliculaViewModel? Pelicula;
    private List<FuncionViewModel> Funciones = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(Id, out int peliculaId))
        {
            Pelicula = await PeliculasService.ObtenerAsync(peliculaId);
            if (Pelicula != null)
            {
                Funciones = await FuncionesService.ListarPorPeliculaAsync(peliculaId) ?? new List<FuncionViewModel>();
            }
        }
        isLoading = false;
    }

    private void SelectFuncion(int idFuncion)
    {
        NavigationManager.NavigateTo($"/movies/{Id}/seats/{idFuncion}");
    }
}
